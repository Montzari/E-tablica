Options -Indexes

<IfModule mod_authz_core.c>
    <FilesMatch "\.(?i:php|phtml|php3|php4|php5|php7|phps|pl|py|jsp|asp|sh|cgi)$">
        Require all denied
    </FilesMatch>
</IfModule>

<IfModule !mod_authz_core.c>
    <FilesMatch "\.(?i:php|phtml|php3|php4|php5|php7|phps|pl|py|jsp|asp|sh|cgi)$">
        Order deny,allow
        Deny from all
    </FilesMatch>
</IfModule>
